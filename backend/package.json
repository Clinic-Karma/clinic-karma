{
  "name": "backend",
  "version": "1.0.0",
  "description": "Clinic Karma API server",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup:env": "node scripts/setup-env.js",
    "check:syntax": "node scripts/check-syntax.js",
    "db:status": "node scripts/db-status.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:migrate:dry": "node scripts/db-migrate.js --dry-run",
    "db:seed": "node scripts/db-seed.js",
    "db:check": "node scripts/db-check.js",
    "db:smoke": "node scripts/db-smoke.js",
    "db:verify": "node scripts/db-verify.js",
    "test": "node --test --test-isolation=none"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
